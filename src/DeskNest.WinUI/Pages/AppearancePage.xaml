<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeskNest.WinUI.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="16">
            <TextBlock Text="外观与主题" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="6 行 × 2 套 + 色板 + 预览卡（S3 迁移）" TextWrapping="Wrap" Opacity="0.75" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="这一页已经接进 WinUI 壳（P1）" FontWeight="SemiBold" />
                    <TextBlock Text="内容会按 S2–S4 逐步从 WPF 版迁移过来；现在只验证导航与主题。" TextWrapping="Wrap" Opacity="0.75" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>