<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskNest.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="桌巢 DeskNest">

    <Grid>
        <NavigationView x:Name="Nav"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="概览" Tag="overview" IsSelected="True">
                    <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="收纳盒" Tag="boxes">
                    <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="Folder"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="外观与主题" Tag="appearance">
                    <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="Color"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="数据与备份" Tag="data">
                    <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="Save"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="关于" Tag="about">
                    <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="Help"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
