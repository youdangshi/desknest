<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskNest.WinUI.Windows.BoxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 盒子 = 自绘标题栏（名称 + 卷起/隐藏）+ 文件列表。系统标题栏在 code-behind 里用 Win32 摘掉。 -->
    <Grid x:Name="Root" AllowDrop="True" Background="{ThemeResource DnCardBg}"
          BorderBrush="{ThemeResource DnCardStroke}" BorderThickness="1" CornerRadius="8">

        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem x:Name="MenuOpenStorage" Text="打开存储位置" Icon="Folder" />
                <MenuFlyoutItem x:Name="MenuAddFiles" Text="添加文件…" Icon="Add" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuRename" Text="重命名…" Icon="Edit" />
                <MenuFlyoutItem x:Name="MenuRollup" Text="卷起">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70E;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuHide" Text="隐藏（到主窗口找回）">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED1A;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuDelete" Text="删除盒子（文件还原）">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarGrid">
            <TextBlock x:Name="TitleText" Text="收纳盒" Margin="12,0,0,0"
                       VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                       IsHitTestVisible="False" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="RollupButton" Content="—" Width="32" Height="24" Margin="0,0,4,0"
                        FontSize="11" ToolTipService.ToolTip="卷起 / 展开" />
                <Button x:Name="CloseButton" Content="✕" Width="32" Height="24"
                        FontSize="11" ToolTipService.ToolTip="隐藏这个盒子" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="ItemList" Background="Transparent" IsItemClickEnabled="True"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8A5;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Text="（空盒子——把文件拖进来，或右键「添加文件」）" Opacity="0.55"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                       IsHitTestVisible="False" TextWrapping="Wrap" Margin="16,0" />
        </Grid>

        <!-- 状态条：拖入/删除等操作的结果提示，几秒后自动消隐 -->
        <Border x:Name="StatusBar" Grid.Row="2" Visibility="Collapsed"
                Background="{ThemeResource DnSubtleBg}" Padding="10,4">
            <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.85"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- 拖入高亮框：用 XAML ThemeResource 取强调色，切主题自动跟（代码里取画笔不会跟） -->
        <Border x:Name="DropFrame" Grid.RowSpan="3" IsHitTestVisible="False"
                BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                BorderThickness="2" CornerRadius="8" Visibility="Collapsed" />
    </Grid>
</Window>
