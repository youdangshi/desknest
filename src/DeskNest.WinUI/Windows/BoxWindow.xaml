<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskNest.WinUI.Windows.BoxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 收纳盒：无边框容器 + 图标网格。
         版式参考：Fences 的半透明容器 + Windows 11 资源管理器的图标网格（图标在上、名称两行居中）。
         系统标题栏在 code-behind 里用 Win32 摘掉。 -->
    <Grid x:Name="Root" AllowDrop="True" Background="{ThemeResource DnCardBg}"
          BorderBrush="{ThemeResource DnCardStroke}" BorderThickness="1" CornerRadius="14">

        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem x:Name="MenuOpenStorage" Text="打开存储位置" Icon="Folder" />
                <MenuFlyoutItem x:Name="MenuAddFiles" Text="添加文件…" Icon="Add" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuRename" Text="重命名…" Icon="Edit" />
                <MenuFlyoutItem x:Name="MenuRollup" Text="卷起">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70E;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuHide" Text="隐藏（到主窗口找回）">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED1A;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuDelete" Text="删除盒子（文件还原）">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏：图标 + 名称 + 数量胶囊；操作按钮平时淡出，鼠标移上来才显形。
             外面套一层带圆角的 Border，靠它裁掉标题栏底色在四角露出的直角。 -->
        <Border CornerRadius="13,13,0,0" Background="{ThemeResource DnSubtleBg}">
        <Grid x:Name="TitleBarGrid" Background="{ThemeResource DnSubtleBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Glyph="&#xE8B7;" FontSize="12" Margin="12,0,8,0"
                      VerticalAlignment="Center" Opacity="0.85" IsHitTestVisible="False" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock x:Name="TitleText" Text="收纳盒" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Border CornerRadius="8" Padding="7,1,7,2" VerticalAlignment="Center"
                        Background="{ThemeResource DnSubtleBg}">
                    <TextBlock x:Name="CountText" Text="0" FontSize="10.5" Opacity="0.8" />
                </Border>
            </StackPanel>

            <StackPanel x:Name="TitleActions" Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center" Opacity="0" Margin="0,0,6,0">
                <Button x:Name="RollupButton" Width="28" Height="22" Margin="0,0,2,0" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="卷起 / 展开">
                    <FontIcon Glyph="&#xE70D;" FontSize="10" />
                </Button>
                <Button x:Name="CloseButton" Width="28" Height="22" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="隐藏这个盒子">
                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>
        </Border>
        <Grid Grid.Row="1">
            <GridView x:Name="ItemList" Background="{ThemeResource DnGlassSurface}" IsItemClickEnabled="True"
                      SelectionMode="Single" Padding="6,4,6,8"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="84" ItemHeight="86" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="76" Spacing="4" Padding="0,4,0,2"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Image Source="{Binding Icon}" Width="40" Height="40"
                                   HorizontalAlignment="Center" />
                            <FontIcon Glyph="{Binding Glyph}" FontSize="28" HorizontalAlignment="Center"
                                      Visibility="{Binding GlyphVisibility}" />
                            <TextBlock Text="{Binding Title}" FontSize="11.5" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                       Height="30" HorizontalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- 空态：虚线框（容器空着的时候别只是一片白） -->
            <Border x:Name="EmptyState" IsHitTestVisible="False" Background="Transparent"
                    Margin="16" CornerRadius="10" BorderThickness="1.5"
                    BorderBrush="{ThemeResource DnCardStroke}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE896;" FontSize="26" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock Text="把文件拖进来" FontSize="12" Opacity="0.55" HorizontalAlignment="Center" />
                    <TextBlock Text="或右键「添加文件」" FontSize="10.5" Opacity="0.4" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="StatusBar" Grid.Row="2" Visibility="Collapsed"
                Background="{ThemeResource DnSubtleBg}" Padding="10,4">
            <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.85" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- 拖入高亮框：用 XAML ThemeResource 取强调色，切主题自动跟 -->
        <Border x:Name="DropFrame" Grid.RowSpan="3" IsHitTestVisible="False"
                BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                BorderThickness="2" CornerRadius="14" Visibility="Collapsed" />
    </Grid>
</Window>
