<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskNest.WinUI.Windows.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 桌面组件 = 自绘标题栏（名称 + 卷起 + 隐藏）+ 内容区。系统标题栏在 code-behind 里摘掉。 -->
    <Grid x:Name="Root" Background="{ThemeResource DnCardBg}"
          BorderBrush="{ThemeResource DnCardStroke}" BorderThickness="1" CornerRadius="12">

        <!-- 右键菜单：关闭 / 重置位置 / 绑定盒子（只有文件组件能绑） -->
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem x:Name="MenuBind" Text="绑定盒子…">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuResetPos" Text="重置位置">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuLook" Text="外观…">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuRename" Text="重命名…">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuClose" Text="关闭组件">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarGrid" Background="{ThemeResource DnSubtleBg}">
            <TextBlock x:Name="TitleText" Text="组件" Margin="12,0,0,0"
                       VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"
                       IsHitTestVisible="False" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="CollapseButton" Width="30" Height="22" Margin="0,0,4,0" Padding="0"
                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="收起 / 展开">
                    <FontIcon Glyph="&#xE70D;" FontSize="9" />
                </Button>
                <Button x:Name="CloseButton" Width="30" Height="22" Padding="0"
                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="隐藏这个组件">
                    <FontIcon Glyph="&#xE711;" FontSize="9" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Background="{ThemeResource DnGlassSurface}" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Content" Padding="12,8,12,12" Spacing="6" />
        </ScrollViewer>
    </Grid>
</Window>
