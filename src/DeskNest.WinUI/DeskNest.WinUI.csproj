<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DeskNest.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- resources.pri 只给 MSIX 用，MakePri 在中文路径下会挂，直接关掉 -->
    <MicrosoftProjectPriGenerationEnable>false</MicrosoftProjectPriGenerationEnable>
    <EnablePriGenTooling>false</EnablePriGenTooling>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <ProjectReference Include="..\DeskNest.Core\DeskNest.Core.csproj" />
    <ProjectReference Include="..\DeskNest.Native\DeskNest.Native.csproj" />
  </ItemGroup>
</Project>

