<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DeskNest.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- resources.pri 必须有：运行时按 MSIX 包跑，MainWindow.xbf 这类 XBF 走 MRT 解析，
         没有 app 自己的 resources.pri 会在 InitializeComponent 里 fail-fast(0xC000027B)。
         MakePri 怀疑过中文路径，实测 x64 makepri 正常，先开着；真挂了再走 ASCII 路径构建。 -->
    <MicrosoftProjectPriGenerationEnable>true</MicrosoftProjectPriGenerationEnable>
    <EnablePriGenTooling>true</EnablePriGenTooling>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <ProjectReference Include="..\DeskNest.Core\DeskNest.Core.csproj" />
    <ProjectReference Include="..\DeskNest.Native\DeskNest.Native.csproj" />
  </ItemGroup>
</Project>

