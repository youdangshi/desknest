<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DeskNest.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- XamlControlsResources is mandatory: without it WinUI controls cannot find their
         theme resources (NavigationView dies with "Cannot find a Resource with the
         Name/Key TabViewButtonBackground"). It is NOT auto-generated - keep it here. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
