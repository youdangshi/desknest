<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DeskNest.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- XamlControlsResources is mandatory: without it WinUI controls cannot find their
         theme resources (NavigationView dies with "Cannot find a Resource with the
         Name/Key TabViewButtonBackground"). It is NOT auto-generated - keep it here. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 自己的主题字典（Dn*）。
                 为什么不用系统那套 CardBackgroundFillColorDefaultBrush：
                 代码里 Application.Current.Resources.ThemeDictionaries 拿不到系统主题字典
                 （里面是空的），只能回退到固定值 #B3FFFFFF——切深色后卡片仍是 70% 白块，
                 白字压浅底又看不清。自己定义一份，深/浅两套色彩都写在明面上。 -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="DnPageBg" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="DnCardBg" Color="#FF2B2B2B" />
                    <SolidColorBrush x:Key="DnCardStroke" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="DnDivider" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="DnSubtleBg" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="DnGlassSurface" Color="#8C1F1F1F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DnPageBg" Color="#FFF3F3F3" />
                    <SolidColorBrush x:Key="DnCardBg" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="DnCardStroke" Color="#14000000" />
                    <SolidColorBrush x:Key="DnDivider" Color="#14000000" />
                    <SolidColorBrush x:Key="DnSubtleBg" Color="#0A000000" />
                    <SolidColorBrush x:Key="DnGlassSurface" Color="#8CFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
