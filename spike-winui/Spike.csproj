<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 不要关 MSIX tooling：它会连带关掉 reg-free WinRT 清单嵌入，导致 RoGetActivationFactory 失败 -->
    <EnableDefaultXamlItems>false</EnableDefaultXamlItems>
    <StartupObject>Spike</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- 免安装 exe：自带 Windows App SDK 运行时，不要求机器预装 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!-- resources.pri 只给 MSIX 用；MakePri.exe 在中文路径/受限环境下会以 0x80070005 退出，直接关掉 -->
    <MicrosoftProjectPriGenerationEnable>false</MicrosoftProjectPriGenerationEnable>
    <EnablePriGenTooling>false</EnablePriGenTooling>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.*" />
  </ItemGroup>
</Project>
